# Environment Variables for DOE Framework Projects
# Copy this file to .env and fill in your actual values
# IMPORTANT: Add .env to .gitignore - never commit credentials!

# ============================================
# AI API Keys
# ============================================

# Anthropic Claude API (required for most workflows)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (if using GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Modal Deployment (Phase 5 - Cloudifying)
# ============================================

# Modal authentication (get from modal.com/settings)
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# Bearer token for securing Modal endpoints (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
BEARER_TOKEN=your_generated_bearer_token_here

# ============================================
# MCP Tools - Web Research
# ============================================

# Brave Search API (free tier: 1,000 searches/month)
# Get key from: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# ============================================
# MCP Tools - Google Workspace
# ============================================

# Google Drive/Sheets access (OAuth credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ============================================
# MCP Tools - Communication
# ============================================

# Slack incoming webhook (for notifications)
# Create at: https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# SendGrid API key (for email sending)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ============================================
# Database (if using)
# ============================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/your_database

# ============================================
# Third-Party Integrations (examples)
# ============================================

# HubSpot API key
HUBSPOT_API_KEY=your_hubspot_api_key

# Airtable API key
AIRTABLE_API_KEY=your_airtable_api_key

# Stripe API key (use test key for development)
STRIPE_API_KEY=sk_test_your_stripe_test_key

# ============================================
# Application Settings
# ============================================

# Environment designation
ENVIRONMENT=development  # development, staging, or production

# Debug mode
DEBUG=true

# Log level
LOG_LEVEL=info  # debug, info, warning, error

# ============================================
# Security Notes
# ============================================

# 1. NEVER commit this file to version control
# 2. Add .env to your .gitignore file
# 3. Use different credentials for dev/staging/production
# 4. Rotate API keys regularly (at least quarterly)
# 5. Use Modal Secrets for production deployments (not .env files)
# 6. Store team credentials in a password manager (1Password, LastPass, etc.)

# ============================================
# Loading Instructions
# ============================================

# For Python:
# pip install python-dotenv
# In your code: from dotenv import load_dotenv; load_dotenv()

# For Node.js:
# npm install dotenv
# In your code: require('dotenv').config()

# For Modal (production):
# Don't use .env files - use Modal Secrets instead:
# modal secret create my-secrets ANTHROPIC_API_KEY=... BEARER_TOKEN=...
