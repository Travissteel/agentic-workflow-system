{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ],
      "description": "Browser automation for visual testing and web scraping"
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Web search for research and data gathering"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/travi/claude-agent-system"
      ],
      "description": "Local filesystem access for reading/writing project files"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "description": "GitHub integration for repository operations"
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "description": "Persistent memory for maintaining context across sessions"
    },
    "google-drive": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gdrive"
      ],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}"
      },
      "description": "Google Drive integration for document access"
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "description": "Slack integration for team communication"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:password@localhost/dbname"
      ],
      "description": "PostgreSQL database access"
    }
  },
  "globalShortcut": "Ctrl+Space",
  "configVersion": "1.0",
  "notes": {
    "setup": "This MCP configuration provides tool access for the DOE framework",
    "usage": {
      "playwright": "Used by tester agent for visual verification",
      "brave-search": "Used for research and data gathering tasks",
      "filesystem": "Core tool for reading directives and writing executions",
      "github": "For version control and directive updates",
      "memory": "Maintains context for self-annealing",
      "google-drive": "Optional: For client document access",
      "slack": "Optional: For notifications and alerts",
      "postgres": "Optional: For database-backed workflows"
    },
    "environment_variables": {
      "required": [
        "BRAVE_API_KEY",
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ],
      "optional": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SLACK_BOT_TOKEN",
        "SLACK_TEAM_ID"
      ],
      "note": "Store these in your .env file, never in this config"
    },
    "installation": "Run: npm install -g @modelcontextprotocol/server-* for each server you need"
  }
}
